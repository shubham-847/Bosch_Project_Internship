    def generate_scatter_plot(file_path, x_data, y_data, x_label, y_label, chart_title, sheet_name="Sheet1"):
        try:
            workbook = xlsxwriter.Workbook(file_path)
            worksheet = workbook.add_worksheet(sheet_name)

            headings = ['X Values', 'Y Values']
            data = [x_data, y_data]

            worksheet.write_row('A1', headings)
            worksheet.write_column('A2', data[0]) 
            worksheet.write_column('B2', data[1])  
            scatter_chart = workbook.add_chart({'type': 'scatter'})
            scatter_chart.add_series({
                'categories': f'={sheet_name}!$A$2:$A${len(x_data) + 1}',
                'values': f'={sheet_name}!$B$2:$B${len(y_data) + 1}',
                'name': '',  
                'marker': {'type': 'circle', 'size': 6},  # Ensure points are visible
            })

            # Add chart title and axis labels
            scatter_chart.set_title({'name': chart_title})
            scatter_chart.set_x_axis({
                'name': x_label,
                'line': {'color': 'black'},
                'major_tick_mark': 'outside',
                'minor_tick_mark': 'none',
                'num_format': 'General',  
            })
            scatter_chart.set_y_axis({
                'name': y_label,
                'line': {'color': 'black'},
                'major_tick_mark': 'outside',
                'minor_tick_mark': 'none',
                'num_format': 'General',
            })
            scatter_chart.set_legend({'position': 'none'})

            worksheet.insert_chart('D2', scatter_chart)

            workbook.close()
            print(f"Scatter plot saved to '{file_path}' successfully.")
        except Exception as e:
            print(f"Failed to generate scatter plot. Error: {e}")

          
