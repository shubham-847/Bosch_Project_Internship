        if not file_location or file_location == "Click to choose location...":
            messagebox.showerror("Error", "Please select a file location.")
            return
        
        # Ensure the file name has the proper extension.
        if not file_name.lower().endswith(".pptx"):
            file_name += ".pptx"
            
        new_file_path = os.path.join(file_location, file_name)
        
        try:
            # Copy the updated presentation to the new location.
            if hasattr(self, 'ppt_path') and os.path.exists(self.ppt_path):
                shutil.copy2(self.ppt_path, new_file_path)
                messagebox.showinfo("Success", f"Presentation saved as:\n{new_file_path}")
            else:
                messagebox.showerror("Error", "The original presentation file was not found.")
                return
            
            if hasattr(self, 'original_slide_count'):
                ppt_app = win32.Dispatch("PowerPoint.Application")
                ppt_app.Visible = True
                pres = ppt_app.Presentations.Open(self.ppt_path)
                # Remove extra slides until only the original slides remain.
                while pres.Slides.Count > self.original_slide_count:
                    pres.Slides(pres.Slides.Count).Delete()
                pres.Save()
                pres.Close()
                ppt_app.Quit()
            else:
                messagebox.showwarning("Warning", "Original slide count not recorded. Template was not reverted.")
        except Exception as e:
            messagebox.showerror("Error", f"Failed to save file or revert template:\n{str(e)}")
        
        # Close the Save As window.
        self.save_as_window.destroy()


