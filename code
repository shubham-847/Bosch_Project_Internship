    def initialize_dropdowns(self):
        options = list(self.df.columns)

        # X Dropdown
        if not hasattr(self, 'x_dropdown'):
            self.x_var = tk.StringVar()
            self.x_dropdown_visible = False
            self.x_dropdown = tk.Frame(self.sub_frame, bd=1, relief="solid")
            self.x_search = tk.Entry(self.x_dropdown, width=20)
            self.x_search.pack(fill="x")
            self.x_search.insert(0, "Search X...")
            self.x_search.bind("<KeyRelease>", lambda event: self.filter_listbox(self.x_search, self.x_list, options))
            self.x_list = tk.Listbox(self.x_dropdown, height=5, width=20)
            self.x_list.pack(fill="both", expand=True)
            for opt in options:
                self.x_list.insert(tk.END, opt)
            self.x_list.bind("<<ListboxSelect>>", self.on_x_select)
            self.x_dropdown.grid(row=2, column=1, sticky="nsew", padx=2, pady=2)
            self.x_dropdown.grid_remove()

        # Y Dropdown
        if not hasattr(self, 'y_dropdown'):
            self.y_var = tk.StringVar()
            self.y_dropdown_visible = False
            self.y_dropdown = tk.Frame(self.sub_frame, bd=1, relief="solid")
            self.y_search = tk.Entry(self.y_dropdown, width=20)
            self.y_search.pack(fill="x")
            self.y_search.insert(0, "Search Y...")
            self.y_search.bind("<KeyRelease>", lambda event: self.filter_listbox(self.y_search, self.y_list, options))
            self.y_list = tk.Listbox(self.y_dropdown, height=5, width=20)
            self.y_list.pack(fill="both", expand=True)
            for opt in options:
                self.y_list.insert(tk.END, opt)
            self.y_list.bind("<<ListboxSelect>>", self.on_y_select)
            self.y_dropdown.grid(row=2, column=3, sticky="nsew", padx=2, pady=2)
            self.y_dropdown.grid_remove()


    def filter_listbox(self, search_entry, listbox, options):
        search_text = search_entry.get().lower()
        listbox.delete(0, tk.END)
        for opt in options:
            if search_text in opt.lower():
                listbox.insert(tk.END, opt)


    def on_x_select(self, event):
        try:
            index = self.x_list.curselection()[0]
            value = self.x_list.get(index)
            self.x_var.set(value)
        except IndexError:
            return
        # Reset search entry for next time.
        self.x_search.delete(0, tk.END)
        self.x_search.insert(0, "Search X...")
        self.x_dropdown.grid_remove()
        self.x_dropdown_visible = False


    def on_y_select(self, event):
        try:
            index = self.y_list.curselection()[0]
            value = self.y_list.get(index)
            self.y_var.set(value)
        except IndexError:
            return
        self.y_search.delete(0, tk.END)
        self.y_search.insert(0, "Search Y...")
        self.y_dropdown.grid_remove()
        self.y_dropdown_visible = False


    def show_x_dropdown(self):
        if not hasattr(self, 'x_dropdown'):
            self.initialize_dropdowns()  

        if self.x_dropdown_visible:
            self.x_dropdown.grid_remove()
            self.x_dropdown_visible = False
        else:
            self.x_dropdown.grid()
            self.x_dropdown_visible = True


    def show_y_dropdown(self):
        if not hasattr(self, 'y_dropdown'):
            self.initialize_dropdowns()  # Ensure dropdowns are initialized

        if self.y_dropdown_visible:
            self.y_dropdown.grid_remove()
            self.y_dropdown_visible = False
        else:
            self.y_dropdown.grid()
            self.y_dropdown_visible = True





