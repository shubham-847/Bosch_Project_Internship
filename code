    def plot_scatter_to_excel(self):
        try:
            if not hasattr(self, 'excel_file_path') or not self.excel_file_path:
                raise ValueError("No Excel file is loaded. Please upload a file first.")

            file_path = self.excel_file_path
            wb = load_workbook(file_path)

            # Existing sheet names
            existing_sheets = wb.sheetnames
            print(f"Existing sheets before creating: {existing_sheets}")

            for idx, row in enumerate(self.entries):
                try:
                    x_column = row["X Variable"].get().strip()
                    y_column = row["Y Variable"].get().strip()
                    tab_name = row["Tabs"].get().strip()
                    map_name = row["Map Name"].get().strip()

                    if not tab_name:
                        messagebox.showerror("Error", f"Row {idx + 1}: Tab name is missing.")
                        continue

                    if not x_column or not y_column:
                        messagebox.showerror("Error", f"Row {idx + 1}: X or Y variable is missing.")
                        continue

                    if tab_name in wb.sheetnames:
                        print(f"Row {idx + 1}: Sheet '{tab_name}' already exists.")
                        sheet = wb[tab_name]
                    else:
                        print(f"Row {idx + 1}: Creating new sheet '{tab_name}'.")
                        sheet = wb.create_sheet(tab_name)

                    if x_column not in self.df.columns or y_column not in self.df.columns:
                        raise ValueError(f"Row {idx + 1}: Column {x_column} or {y_column} not found in data.")

                    self.df[x_column] = pd.to_numeric(self.df[x_column], errors="coerce")
                    self.df[y_column] = pd.to_numeric(self.df[y_column], errors="coerce")
                    filtered_df = self.df.dropna(subset=[x_column, y_column])

                    print(f"Row {idx + 1}: Filtered data for X: {filtered_df[x_column].tolist()}")
                    print(f"Row {idx + 1}: Filtered data for Y: {filtered_df[y_column].tolist()}")

                    if filtered_df.empty:
                        raise ValueError(f"Row {idx + 1}: No valid data found for X: {x_column} and Y: {y_column}.")

                    x_data = filtered_df[x_column].tolist()
                    y_data = filtered_df[y_column].tolist()

                    if not x_data or not y_data:
                        raise ValueError(f"Row {idx + 1}: X or Y data is empty after filtering.")

                    start_row = 1  
                    sheet.cell(row=start_row, column=1, value=f"{x_column} vs {y_column}")
                    sheet.cell(row=start_row + 1, column=1, value=x_column)
                    sheet.cell(row=start_row + 1, column=2, value=y_column)

                    for i, (x, y) in enumerate(zip(x_data, y_data), start=start_row + 2):
                        sheet.cell(row=i, column=1, value=x)
                        sheet.cell(row=i, column=2, value=y)

                    # Create scatter chart
                    chart = ScatterChart()
                    chart.title = map_name or f"{x_column} vs {y_column}"
                    chart.x_axis.title = x_column
                    chart.y_axis.title = y_column

                    if not x_data or not y_data:
                        raise ValueError(f"Row {idx + 1}: No valid data available for charting.")
                    
                    x_values = Reference(sheet, min_col=1, min_row=start_row + 2, max_row=start_row + 1 + len(x_data))
                    y_values = Reference(sheet, min_col=2, min_row=start_row + 2, max_row=start_row + 1 + len(y_data))

                    if x_values.min_row > x_values.max_row or y_values.min_row > y_values.max_row:
                        raise ValueError(f"Row {idx + 1}: Invalid reference range for chart.")

                    series = Series(y_values, x_values, title=f"{x_column} vs {y_column}")
                    series.marker.symbol = "circle"
                    series.graphicalProperties.line.noFill = True
                    chart.series.append(series)

                    # Insert the chart into the sheet
                    chart_position = f"E{start_row}"  
                    sheet.add_chart(chart, chart_position)

                    print(f"Row {idx + 1}: Scatter plot created successfully on sheet '{tab_name}'.")

                except Exception as inner_error:
                    print(f"Row {idx + 1}: Error occurred - {str(inner_error)}")
                    messagebox.showerror("Error", f"Row {idx + 1}: Failed to process due to {str(inner_error)}")

            # Save the workbook
            wb.save(file_path)
            print(f"Scatter plots created successfully. Existing sheets after creating: {wb.sheetnames}")

        except Exception as e:
            print(f"Failed to plot scatter: {str(e)}")
            messagebox.showerror("Error", f"Failed to plot scatter.\nError: {str(e)}")


