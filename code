    def show_variable_dropdown(self):
        if self.df is None or self.df.empty:
            messagebox.showerror("Error", "No Excel file uploaded!")
            return
        column_options = list(self.df.columns)
        self.block_var = StringVar()
        self.block_var.set("Select column")  

        self.column_dropdown = ttk.Combobox(
            self.block_frame,
            textvariable=self.block_var,
            values=column_options, 
            state="readonly",
            width=25
        )
        self.column_dropdown.place(x=170, y=10)
        self.column_dropdown.bind("<<ComboboxSelected>>", self.update_values_dropdown)

        self.value_var = StringVar()
        self.value_var.set("Select value") 
        self.value_dropdown = ttk.Combobox(
            self.block_frame,
            textvariable=self.value_var,
            values=[], 
            state="readonly",
            width=25
        )
        self.value_dropdown.place(x=360, y=10) 


    def update_values_dropdown(self, event):
        selected_column = self.block_var.get().strip() 
        if selected_column and selected_column in self.df.columns:
            unique_values = list(self.df[selected_column].dropna().unique())
            
            preferred_order = ["Target VVT", "Reference VVT"]
            unique_values = sorted(unique_values, key=lambda x: (preferred_order.index(x) if x in preferred_order else len(preferred_order), x))

            self.value_dropdown['values'] = unique_values
            self.value_var.set("Select value")

            self.block1_entry.delete(0, END)
            self.block1_entry.insert(0, unique_values[0] if len(unique_values) > 0 else "")

            self.block2_entry.delete(0, END)
            self.block2_entry.insert(0, unique_values[1] if len(unique_values) > 1 else "")

            self.block3_entry.delete(0, END)
            self.block3_entry.insert(0, unique_values[2] if len(unique_values) > 2 else "")
            
            self.block_data = {}



    def filter_combobox(self, event, combobox, options):
        value = event.widget.get().lower()
        filtered_options = [option for option in options if value in option.lower()]
        combobox['values'] = filtered_options


