    def get_block_ranges(self):

        block_ranges = {}
        if hasattr(self, 'block_data'):
            for block_key, value in self.block_data.items():
                if value and value != "-":  
                    rows = self.df[self.df["BlockID"].astype(str)
                                .str.strip()
                                .str.lower() == value.lower()].index.tolist()
                    print(f"Rows for value '{value}' in BlockID column:", rows)
                    if rows:
                        block_ranges[block_key] = (min(rows) + 1, max(rows) + 1)
        print("Computed block ranges:", block_ranges)
        return block_ranges



    def update_chart_colors(self, chart, start_col, tab_name):
        block_ranges = self.get_block_ranges()
        colors = {
            "BlockID 1": "#002060",  
            "BlockID 2": "#A80163", 
            "BlockID 3": "#008000"   
        }
        if block_ranges:
            for block_key, (start_row, end_row) in block_ranges.items():
                color = colors.get(block_key, "#000000")
                print(f"Adding series for {block_key} from row {start_row} to {end_row} with color {color}")
                chart.add_series({
                    'categories': [tab_name, start_row, start_col, end_row, start_col],
                    'values': [tab_name, start_row, start_col + 1, end_row, start_col + 1],
                    'marker': {
                        'type': 'circle',
                        'size': 5,
                        'fill': {'color': color},
                        'border': {'none': True}
                    },
                    'name': block_key
                })
        else:
            chart.add_series({
                'categories': [tab_name, 1, start_col, len(self.df), start_col],
                'values': [tab_name, 1, start_col + 1, len(self.df), start_col + 1],
                'marker': {
                    'type': 'circle',
                    'size': 5,
                    'fill': {'color': '#002060'},
                    'border': {'none': True}
                },
                'name': ''
            })
  

