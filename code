    def save_rows(self):
        saved_data = []
        for entry in self.entries:
            row_data = {
                'Model': entry['Model'].get(),
                'X Variable': entry['X Variable'].get(),
                'X Range': {
                    'Min': entry['X Range Min Input'].get(),
