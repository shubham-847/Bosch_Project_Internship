                        kpi_val = update["KPI achieved"]
                        if kpi_val is None or (isinstance(kpi_val, float) and math.isnan(kpi_val)):
                            kpi_val = ""
                        else:
                            kpi_val = str(kpi_val)
                        df_tol.at[i, "KPI achieved"] = kpi_val
                        df_tol.at[i, "KPI BlockID1 (Target VVT)"] = update["KPI BlockID1 (Target VVT)"]
                        df_tol.at[i, "KPI BlockID2 (Reference VVT)"] = update["KPI BlockID2 (Reference VVT)"]

                df_tol["Order"] = df_tol["Model Name"].apply(lambda x: model_names_fixed.index(x) if x in model_names_fixed else 999)
                df_tol = df_tol.sort_values("Order").drop(columns="Order")
                df_tol = df_tol[header_list]
                tol_sheet.range("A1").options(index=False, header=True).value = df_tol

                data_range = tol_sheet.range("A1").expand()
                try:
                    table = tol_sheet.api.ListObjects("TolerancesTable")
                    table.Delete()
                except Exception:
                    pass
                table = tol_sheet.api.ListObjects.Add(SourceType=1, Source=data_range.api, XlListObjectHasHeaders=1)
                table.Name = "TolerancesTable"
                table.TableStyle = "TableStyleMedium2"
                header_range = tol_sheet.range("A1:G1")
                header_range.api.Font.Name = "Calibri"
                header_range.api.Font.Size = 11
                header_range.api.Font.Bold = True
                header_range.api.HorizontalAlignment = -4108  
                tol_sheet.range("A1").row_height = 32.40
                tol_sheet.range("A:A").column_width = 30
                tol_sheet.range("B:B").column_width = 30
                tol_sheet.range("C:C").column_width = 20
                tol_sheet.range("D:D").column_width = 20
                tol_sheet.range("E:E").column_width = 20
                tol_sheet.range("F:F").column_width = 24
                tol_sheet.range("G:G").column_width = 25

                last_data_row = tol_sheet.range("A1").expand().last_cell.row
                kpi_range = tol_sheet.range(f"E2:E{last_data_row}")
                for cell in kpi_range:
                    val = cell.value
                    if val is None or (isinstance(val, str) and val.strip() == ""):
                        cell.value = ""
                        cell.api.Interior.ColorIndex = 0
                        continue
                    try:
                        if isinstance(val, str):
                            numeric_val = float(val.replace('%', '').strip()) / 100
                        elif isinstance(val, (int, float)):
                            numeric_val = val / 100 if val > 1 else val
                        else:
                            numeric_val = 0
                        if numeric_val >= 0.95:
                            cell.api.Interior.Color = 0x4FBD31  
                        else:
                            cell.api.Interior.Color = 0x2CF8E0  
                    except Exception as e:
                        print("Error formatting KPI achieved cell", cell.address, e)
                        cell.value = ""
                        cell.api.Interior.ColorIndex = 0

            data_sheet = wb.sheets["data"]
            data_sheet.api.Move(Before=wb.sheets[0].api)


            wb.save()
            messagebox.showinfo("Success", "Plot generated successfully!")

            with open(config_file, "w") as f:
                json.dump(saved_charts, f)

        except Exception as e:
            messagebox.showerror("Error", f"Failed to plot scatter.\nError: {str(e)}")
        finally:
            try:
                if wb:
                    wb.close()
            except Exception:
                pass
            if app:
                app.quit()


