    def save_rows2(self):

        saved_data = []
        for row in self.sub_heading_entries:

            row_data = {
                "Sub Heading": row[0].get(),
                "Map Names": [row[1].get(), row[2].get()],
                "Tab Name": row[3].get(),
                "Quality Criteria": row[4].get(),
                "Formula": row[5].get() if len(row) > 5 else ""
            }
            saved_data.append(row_data)
        
        file_path = filedialog.asksaveasfilename(
            defaultextension=".json",
            filetypes=[("JSON files", "*.json"), ("All files", "*.*")]
        )
        if not file_path:
            return
        with open(file_path, "w") as f:
            json.dump(saved_data, f, indent=4)
        tk.messagebox.showinfo("Success", "Rows saved successfully!")

    def import_rows2(self):

        file_path = filedialog.askopenfilename(
            filetypes=[("JSON files", "*.json"), ("All files", "*.*")]
        )
        if not file_path:
            return
        with open(file_path, "r") as f:
            saved_data = json.load(f)
        
        for widget in self.sub_heading_container.winfo_children():
            widget.destroy()
        self.sub_heading_entries = []  
        
        for row_data in saved_data:

            self.add_sub_heading_field()
            current_entry = self.sub_heading_entries[-1]
            
            current_entry[0].delete(0, tk.END)
            current_entry[0].insert(0, row_data.get("Sub Heading", ""))
            
            map_names = row_data.get("Map Names", ["", ""])
            current_entry[1].delete(0, tk.END)
            current_entry[1].insert(0, map_names[0])
            current_entry[2].delete(0, tk.END)
            current_entry[2].insert(0, map_names[1])
            
            current_entry[3].delete(0, tk.END)
            current_entry[3].insert(0, row_data.get("Tab Name", ""))
            
            current_entry[4].delete(0, tk.END)
            current_entry[4].insert(0, row_data.get("Quality Criteria", ""))
            
            if len(current_entry) > 5:
                current_entry[5].delete(0, tk.END)
                current_entry[5].insert(0, row_data.get("Formula", ""))
        
        



